OPENAI_API_KEY_CHESS_TUTOR=
LLM_PROVIDER=openai
LLM_MODEL=gpt-4.1-mini
# Optional: a model for the fact-check calls only. Defaults to LLM_MODEL on the same provider.
# LLM_AUDIT_MODEL=gpt-4.1
# To fact-check on a local OpenAI-compatible server (e.g. Ollama) while lessons use OpenAI,
# also set its URL. Thinking models need low effort to keep each check fast.
# LLM_AUDIT_BASE_URL=http://127.0.0.1:11434/v1
# LLM_AUDIT_MODEL=gpt-oss:120b
# LLM_AUDIT_REASONING_EFFORT=low
# LLM_AUDIT_API_KEY=
# For a later OpenAI-compatible local model:
# LLM_PROVIDER=compatible
# LLM_BASE_URL=http://127.0.0.1:11434/v1
# LLM_MODEL=your-local-model
# LLM_API_KEY=
PORT=3000

# Hosting: keep loopback for local development.
HOST=127.0.0.1
# Set to the exact HTTPS origin when hosted behind a reverse proxy.
# CHESS_PUBLIC_ORIGIN=https://your-app-domain
