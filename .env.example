OPENAI_API_KEY_CHESS_TUTOR=
LLM_PROVIDER=openai
LLM_MODEL=gpt-4.1-mini
# For reasoning models (GPT-5 and later), set how much the writer thinks: none, low, medium...
# The fact-check uses the same setting unless LLM_AUDIT_MODEL or LLM_AUDIT_REASONING_EFFORT is set.
# LLM_REASONING_EFFORT=none
# Fewest fallbacks measured (Nov 2026, ~5s and ~$0.007 a lesson): gpt-6.1-terra for both, with none:
# LLM_MODEL=gpt-6.1-terra
# LLM_REASONING_EFFORT=none
# Turn commentary after each Black reply is built from Stockfish and chess.js with no model call: Black's threats,
# mistakes in your move, and chances to punish Black's mistakes. Set to "model" for the earlier model-written version.
# TUTOR_TURN_COMMENTARY=model
# Hints are built the same way, in three levels (the idea, the piece, the move). Set to "model" for the earlier
# model-written hints.
# TUTOR_HINTS=model
# Optional: a model for the fact-check calls only. Defaults to LLM_MODEL on the same provider.
# LLM_AUDIT_MODEL=gpt-4.1
# To fact-check on a local OpenAI-compatible server (e.g. Ollama) while lessons use OpenAI,
# also set its URL. Thinking models must have thinking limited or off, or checks time out:
# gpt-oss takes low (most accurate, ~13s a check); Gemma 4, Qwen, GLM and Nemotron need none.
# LLM_AUDIT_BASE_URL=http://127.0.0.1:11434/v1
# LLM_AUDIT_MODEL=gpt-oss:120b
# LLM_AUDIT_REASONING_EFFORT=low
# Faster local option (~2.5s a check): LLM_AUDIT_MODEL=gemma4:26b with LLM_AUDIT_REASONING_EFFORT=none
# LLM_AUDIT_API_KEY=
# For a later OpenAI-compatible local model:
# LLM_PROVIDER=compatible
# LLM_BASE_URL=http://127.0.0.1:11434/v1
# LLM_MODEL=your-local-model
# LLM_API_KEY=
PORT=3000

# Hosting: keep loopback for local development.
HOST=127.0.0.1
# Set to the exact HTTPS origin when hosted behind a reverse proxy.
# CHESS_PUBLIC_ORIGIN=https://your-app-domain
